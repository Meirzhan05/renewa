# Store these with `supabase secrets set --env-file supabase/functions/.env`.
# Never commit the real .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# 32 random bytes, base64-encoded. Generate: openssl rand -base64 32
MAIL_TOKEN_ENCRYPTION_KEY=

# --- Agentic discovery pipeline (optional; OFF unless AGENTIC_DISCOVERY=on) ---
# When off, or when the classifier vars below are unset, discovery falls back to the
# legacy keyword prefilter + per-message extraction. Turning it on requires DEEPSEEK_* set.
AGENTIC_DISCOVERY=off
# Tier-1 wide classifier (cheap/fast, OpenAI-compatible). If any of these are unset the
# classifier tier falls back to the DeepSeek config above.
CLASSIFIER_BASE_URL=
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=
# Optional override for the tier-2 reasoner base URL (defaults to https://api.deepseek.com/v1)
DEEPSEEK_BASE_URL=
