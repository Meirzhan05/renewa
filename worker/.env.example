# Persistent agent worker configuration. Copy to .env (gitignored) and fill in.

# Postgres connection string. Used for BOTH the job queue and the LangGraph checkpointer.
# In this project it points at the same Supabase Postgres the edge functions use.
DATABASE_URL=postgres://user:password@host:5432/postgres

# How often (ms) the worker polls for new jobs / answered clarifications when idle.
WORKER_POLL_INTERVAL_MS=3000

# Tier-2 reasoner + verifier model (DeepSeek). Required.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Optional cheaper tier-1 classifier. If unset, the worker falls back to the DeepSeek config.
CLASSIFIER_BASE_URL=
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=
