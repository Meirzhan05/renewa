# Persistent agent worker configuration. Copy to .env (gitignored) and fill in.

# Postgres connection string. Used for BOTH the job queue and the LangGraph checkpointer.
# In this project it points at the same Supabase Postgres the edge functions use.
DATABASE_URL=postgres://user:password@host:5432/postgres

# Managed tasks call the protected email-scan Function to claim a page and obtain a short-lived
# provider credential. These are public project values, not service-role credentials.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Managed Trigger tasks use their own deliberately tiny database pool. In hosted Supabase, use the
# Transaction pooler connection string (port 6543), never the Session pooler (5432).
# Locally this may be the normal local Postgres URL.
MANAGED_DATABASE_URL=postgres://user:password@host:6543/postgres
MANAGED_DATABASE_REQUIRE_TRANSACTION_POOLER=true
MANAGED_DATABASE_POOL_MAX=1
INBOX_AGENT_GLOBAL_CONCURRENCY=4
INBOX_AGENT_GOOGLE_CONCURRENCY=4
INBOX_AGENT_MICROSOFT_CONCURRENCY=4
INBOX_AGENT_PER_USER_CONCURRENCY=1

# How often (ms) the worker polls for new jobs / answered clarifications when idle.
WORKER_POLL_INTERVAL_MS=3000

# Tier-2 reasoner + verifier model (DeepSeek). Required.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Optional cheaper tier-1 classifier. If unset, the worker falls back to the DeepSeek config.
CLASSIFIER_BASE_URL=
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=

# Trigger.dev managed Inbox runtime. These are server-only and never belong in iOS configuration.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
MANAGED_AGENT_SHARED_SECRET=

# Optional LangSmith tracing (dev/testing). When on, each scan streams a full trace to your
# LangSmith project. Off unless LANGSMITH_TRACING=true. Traces contain your inbox data, so keep
# this to your own account / dev only.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=renewa-agent

# --- Gmail smoke test (scripts/gmail-scan.ts) -------------------------------------------------
# Runs the two-tier funnel against your REAL inbox via the Gmail API (OAuth, read-only) and writes
# the processed emails to out/ (gitignored). One-time Google setup:
#   1. console.cloud.google.com → create/select a project.
#   2. APIs & Services → Library → enable "Gmail API".
#   3. OAuth consent screen → External → add your email under "Test users".
#   4. Credentials → Create credentials → OAuth client ID → type "Web application".
#      Under "Authorized redirect URIs" add EXACTLY:  http://127.0.0.1:42813
#      (must match GMAIL_OAUTH_PORT below). Then copy the id + secret here.
# First run opens a browser once to authorize; the token is cached in out/gmail-token.json.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_PORT=42813
# Host used in the redirect URI. Register http://<host>:<port> on the OAuth client. Default 127.0.0.1.
GMAIL_OAUTH_REDIRECT_HOST=127.0.0.1
GMAIL_SCAN_LIMIT=150
GMAIL_SCAN_SINCE_DAYS=60
